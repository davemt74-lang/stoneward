# Stonefellow v1.2.0 installed application
DirectoryIndex stonefellow-v120.php index.php

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# Private application data/config are never web-addressable.
RewriteRule ^(?:data|config)/ - [F,L,NC]
RewriteRule ^storage/ - [F,L,NC]
# PWA + SEO/crawler endpoints.
RewriteRule ^manifest\.webmanifest$ manifest.php [L]
# SEO/crawler endpoints.
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# Canonical public content routes.
RewriteRule ^track/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=track&id=$1 [QSA,L]
RewriteRule ^release/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=release&id=$1 [QSA,L]
RewriteRule ^show/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=show&id=$1 [QSA,L]
RewriteRule ^store/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=store&slug=$1 [QSA,L]
RewriteRule ^campaign/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=campaign&slug=$1 [QSA,L]
RewriteRule ^press/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=press&slug=$1 [QSA,L]
RewriteRule ^story/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=story&slug=$1 [QSA,L]
RewriteRule ^video/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=video&slug=$1 [QSA,L]
RewriteRule ^photos/([A-Za-z0-9_-]+)/?$ stonefellow-v120.php?view=photo&slug=$1 [QSA,L]
RewriteRule ^photos/?$ stonefellow-v120.php?view=photos [QSA,L]
RewriteRule ^search/?$ stonefellow-v120.php?view=search [QSA,L]
RewriteRule ^(world|music|releases|shows|videos|store|about|contact|archive)/?$ stonefellow-v120.php?view=$1 [QSA,L]

# Never serve a stale legacy static shell.
RewriteRule ^index\.html$ ./ [R=302,L]
# Old setup URLs always return to the live application.
RewriteRule ^install\.php$ ./ [R=302,L]
RewriteRule ^install(?:/.*)?$ ./ [R=302,L]
# Direct legacy index.php requests return to the current root route.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ ./ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "^(stonefellow-v120\.php|index\.php|version\.php)$">
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header always set Pragma "no-cache"
Header always set Expires "0"
Header always set X-Stonefellow-Build "1.3.186"
</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
<Files "service-worker.js">
Header always set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
</IfModule>
